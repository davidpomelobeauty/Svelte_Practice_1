{
  "tasks": {
    "dev": "deno run -A npm:vite dev --open",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "check": "deno run -A npm:svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "deno run -A npm:svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "imports": {
    "#lib": "./src/lib/index.ts",
    "#lib/*": "./src/lib/*",
    "@deno/svelte-adapter": "npm:@deno/svelte-adapter@^0.2.1",
    "@skeletonlabs/skeleton": "npm:@skeletonlabs/skeleton@^5.0.1",
    "@skeletonlabs/skeleton-svelte": "npm:@skeletonlabs/skeleton-svelte@^5.0.1",
    "@sveltejs/kit": "npm:@sveltejs/kit@^3.0.0",
    "@sveltejs/vite-plugin-svelte": "npm:@sveltejs/vite-plugin-svelte@^7.2.0",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@tsconfig/svelte": "npm:@tsconfig/svelte@^5.0.8",
    "@types/node": "npm:@types/node@^26.6.4",
    "dinero.js": "npm:dinero.js@^2.0.2",
    "svelte": "npm:svelte@^5.56.7",
    "svelte-check": "npm:svelte-check@^4.6.0",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "typescript": "npm:typescript@^6.0.3",
    "vite": "npm:vite@^8.3.0"
  },
  "nodeModulesDir": "auto",
  "allowScripts": ["npm:svelte-kit"],
  "include": ["src/**/*"],
  "exclude": ["node_modules", ".svelte-kit", "build", ".deno"]
}
